          hints: ["Record start time", "Yield", "Print elapsed time"],
          solution: { python: "from contextlib import contextmanager\nimport time\n\n@contextmanager\ndef timer():\n    start = time.time()\n    yield\n    print(f\"Elapsed: {time.time() - start}s\")" },
