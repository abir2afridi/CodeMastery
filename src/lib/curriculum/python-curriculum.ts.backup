      sections: [
        {
          id: "ch76-log-analyzer",
          title: "Log Analyzer",
          whyItMatters: "Log analysis helps debug issues and understand system behavior.",
          realWorldAnalogy: "Log analyzer is like a detective - it finds patterns in system events.",
          content: "Parse Logs\n\nimport re\n\nlog_pattern = r'\\[(\\d{4}-\\d{2}-\\d{2})\\] (\\w+): (.+)'\n\nwith open('app.log', 'r') as f:\n    for line in f:\n        match = re.search(log_pattern, line)\n        if match:\n            date, level, message = match.groups()\n\nCount Errors\n\nfrom collections import Counter\n\nerrors = []\nfor line in logs:\n    if 'ERROR' in line:\n        errors.append(line)\n\nerror_counts = Counter(errors)",
          codeExamples: [
            {
              id: "ch76-log-analyzer",
              title: "Log Analyzer",
              description: "Analyze log files",
              code: { python: "import re\nfrom collections import Counter\nfrom datetime import datetime\n\ndef analyze_log(log_file):\n    error_pattern = r'\\[(\\d{4}-\\d{2}-\\d{2})\\s+(\\d{2}:\\d{2}:\\d{2})\\]\\s+(\\w+)\\s+(.+)'\n    \n    errors = []\n    warnings = []\n    \n    with open(log_file, 'r') as f:\n        for line in f:\n            match = re.search(error_pattern, line)\n            if match:\n                date, time, level, message = match.groups()\n                if level == 'ERROR':\n                    errors.append(message)\n                elif level == 'WARNING':\n                    warnings.append(message)\n    \n    print(f\"Total Errors: {len(errors)}\")\n    print(f\"Total Warnings: {len(warnings)}\")\n    print(f\"\\nTop Errors:\")\n    for error, count in Counter(errors).most_common(5):\n        print(f\"  {error}: {count}\")" },
              explanation: "Log analysis uses regex and pattern matching."
            }
          ]
        }
      ],
