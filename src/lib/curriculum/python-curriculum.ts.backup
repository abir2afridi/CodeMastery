          whyItMatters: "File automation saves time and keeps directories organized.",
          realWorldAnalogy: "File organizer is like a librarian - it organizes files by category.",
          content: "pathlib Basics\n\nfrom pathlib import Path\n\nsource = Path('/downloads')\nfor file in source.iterdir():\n    if file.is_file():\n        print(file.name)\n\nOrganize by Extension\n\nfrom pathlib import Path\nimport shutil\n\nsource = Path('/downloads')\nimages = source / 'images'\nimages.mkdir(exist_ok=True)\n\nfor file in source.glob('*.jpg'):\n    shutil.move(str(file), str(images / file.name))",
          codeExamples: [
            {
              id: "ch75-file-organizer",
              title: "File Organizer",
              description: "Automate file management",
              code: { python: "from pathlib import Path\nimport shutil\nimport os\n\ndef organize_files(source_dir):\n    source = Path(source_dir)\n    \n    # Create folders\n    folders = {\n        'images': ['.jpg', '.png', '.gif'],\n        'documents': ['.pdf', '.doc', '.txt'],\n        'music': ['.mp3', '.wav']\n    }\n    \n    for folder_name, extensions in folders.items():\n        folder = source / folder_name\n        folder.mkdir(exist_ok=True)\n    \n    # Move files\n    for file in source.iterdir():\n        if file.is_file():\n            ext = file.suffix.lower()\n            for folder_name, extensions in folders.items():\n                if ext in extensions:\n                    dest = source / folder_name / file.name\n                    shutil.move(str(file), str(dest))\n                    break\n\norganize_files('/Downloads')" },
              explanation: "File automation uses pathlib and shutil."
            }
          ]
        }
      ],
