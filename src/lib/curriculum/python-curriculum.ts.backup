          starterCode: { python: "import random\nimport string\n\nurl_map = {}\n\ndef shorten_url(url):\n    # Generate 6-character code and store" },
          hints: ["Generate random code", "Store in dict"],
          solution: { python: "import random\nimport string\n\nurl_map = {}\n\ndef shorten_url(url):\n    chars = string.ascii_letters + string.digits\n    code = ''.join(random.choice(chars) for _ in range(6))\n    url_map[code] = url\n    return "short.ly/{}".format(code) },
