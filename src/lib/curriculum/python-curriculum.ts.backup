          starterCode: { python: "class Person:\n    def __init__(self, name, age):\n        self.name = name\n        self.age = age\n    \n    @classmethod\n    def from_string(cls, data):\n        # Parse 'Name,Age' string" },
          hints: ["Split the string", "Return cls(name, age)"],
          solution: { python: "class Person:\n    def __init__(self, name, age):\n        self.name = name\n        self.age = age\n    \n    @classmethod\n    def from_string(cls, data):\n        name, age = data.split(',')\n        return cls(name, int(age))" },
          solutionExplanation: "Class methods are factory methods for creating instances."
        }
      ],
