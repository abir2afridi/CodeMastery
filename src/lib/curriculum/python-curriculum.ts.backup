          title: "Encapsulation",
          whyItMatters: "Encapsulation protects data and prevents direct access to internal state.",
          realWorldAnalogy: "Encapsulation is like a capsule - the medicine is inside, protected from outside.",
          content: `Private Attributes

class BankAccount:
    def __init__(self, balance):
        self.__balance = balance  # Private
    
    def get_balance(self):
        return self.__balance

Property Decorator

class Person:
    def __init__(self, age):
        self.__age = age
    
    @property
    def age(self):
        return self.__age`,
          codeExamples: [
            {
              id: "ch23-encapsulation",
              title: "Encapsulation Example",
