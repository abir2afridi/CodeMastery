          hints: ["Create class inheriting Plugin", "Implement execute()"],
          solution: { python: "from abc import ABC, abstractmethod\n\nclass Plugin(ABC):\n    @abstractmethod\n    def execute(self):\n        pass\n\nclass EmailPlugin(Plugin):\n    def execute(self):\n        return \"Sending email...\"" },
          solutionExplanation: "ABCs ensure consistent interfaces."
        }
      ],
