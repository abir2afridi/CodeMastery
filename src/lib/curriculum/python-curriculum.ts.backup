        {
          id: "ch17-context",
          title: "Context Managers",
          whyItMatters: "Context managers ensure resources are properly cleaned up.",
          realWorldAnalogy: "Context managers are like automatic door closers - they ensure things are closed properly.",
          content: `Using Context Managers

with open("file.txt") as f:
    content = f.read()
# File automatically closed

Custom Context Manager

class Timer:
    def __enter__(self):
        self.start = time.time()
        return self
    
    def __exit__(self, *args):
        print("Time: {}".format(time.time() - self.start))`,
          codeExamples: [
            {
              id: "ch17-context",
              title: "Custom Context Manager",
              description: "Creating context managers",
              code: { python: "class Timer:\n    def __enter__(self):\n        print(\"Start\")\n        return self\n    \n    def __exit__(self, *args):\n        print(\"End\")\n\nwith Timer():\n    print(\"Working\")" },
              explanation: "__enter__ sets up, __exit__ cleans up."
            }
          ]
        }
      ],
      exercises: [
