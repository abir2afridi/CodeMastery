          whyItMatters: "Decorators let you modify functions without changing their code.",
          realWorldAnalogy: "Decorators are like gift wrapping - they add functionality around the original.",
          content: `Decorator Syntax

def decorator(func):
    def wrapper():
        print("Before")
        func()
        print("After")
    return wrapper

@decorator
def greet():
    print("Hello!")`,
          codeExamples: [
            {
              id: "ch16-decorators",
              title: "Basic Decorator",
              description: "Creating decorators",
              code: { python: "def uppercase(func):\n    def wrapper():\n        result = func()\n        return result.upper()\n    return wrapper\n\n@uppercase\ndef greet():\n    return \"hello\"\n\nprint(greet())  # HELLO" },
              explanation: "Decorators wrap functions with additional behavior."
            }
          ]
        }
      ],
      exercises: [
        {
          id: "ch16-ex1",
          title: "Timer Decorator",
          difficulty: 1,
          description: "Create a decorator that times function execution.",
          requirements: ["Measure time before and after", "Print elapsed time"],
          starterCode: { python: "import time\n\ndef timer(func):\n    def wrapper():\n        # Your code here" },
          hints: ["Use time.time()", "Call func() between measurements"],
          solution: { python: "import time\n\ndef timer(func):\n    def wrapper():\n        start = time.time()\n        result = func()\n        end = time.time()\n        print(f\"Time: {end - start}s\")\n        return result\n    return wrapper" },
          solutionExplanation: "Decorators can add timing, logging, or validation."
        }
      ],
