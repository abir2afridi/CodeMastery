          realWorldAnalogy: "Contextlib is like a shortcut - it simplifies creating context managers.",
          content: `@contextmanager Decorator

from contextlib import contextmanager

@contextmanager
def timer():
    start = time.time()
    yield
    end = time.time()
    print(f\"Time: {end - start}\")

Using ExitStack

from contextlib import ExitStack

with ExitStack() as stack:
    f1 = stack.enter_context(open('file1.txt'))
    f2 = stack.enter_context(open('file2.txt'))`,
          codeExamples: [
            {
              id: "ch33-contextlib",
              title: "Contextlib",
              description: "Simplified context managers",
              code: { python: "from contextlib import contextmanager\nimport time\n\n@contextmanager\ndef timer(name):\n    start = time.time()\n    yield\n    elapsed = time.time() - start\n    print(f\"{name}: {elapsed}s\")\n\nwith timer(\"task\"):\n    time.sleep(1)" },
              explanation: "@contextmanager creates context managers from generators."
            }
          ]
        }
      ],
