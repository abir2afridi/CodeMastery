      title: "URL Shortener",
      subtitle: "Create URL shortening service",
      difficulty: "Intermediate",
      estimatedMinutes: 50,
      xpReward: 150,
      prerequisites: ["python-ch-77"],
      learningObjectives: [
        "Build web service",
        "Generate short codes",
        "Store mappings",
        "Redirect URLs"
      ],
      sections: [
        {
          id: "ch78-url-shortener",
          title: "URL Shortener",
          whyItMatters: "URL shorteners are practical web services that demonstrate database and web skills.",
          realWorldAnalogy: "URL shortener is like a nickname system - long URLs get short aliases.",
          content: "Generate Short Code\n\nimport random\nimport string\n\ndef generate_short_code(length=6):\n    chars = string.ascii_letters + string.digits\n    return ''.join(random.choice(chars) for _ in range(length))\n\nStore Mapping\n\nurl_map = {}\n\ndef shorten_url(original_url):\n    code = generate_short_code()\n    url_map[code] = original_url\n    return "short.ly/{}".format(code)\n\nFlask Implementation\n\nfrom flask import Flask, redirect\n\n@app.route('/<code>')\ndef redirect_url(code):\n    original = url_map.get(code)\n    return redirect(original)",
          codeExamples: [
            {
              id: "ch78-url-shortener",
              title: "URL Shortener",
              description: "URL shortening service",
              code: { python: "from flask import Flask, request, jsonify, redirect\nimport secrets\nimport string\n\napp = Flask(__name__)\n\n# In-memory storage (use database in production)\nurl_store = {}\n\ndef generate_code(length=6):\n    chars = string.ascii_letters + string.digits\n    return ''.join(secrets.choice(chars) for _ in range(length))\n\n@app.route('/shorten', methods=['POST'])\ndef shorten():\n    data = request.json\n    original_url = data['url']\n    code = generate_code()\n    url_store[code] = original_url\n    short_url = f\"short.ly/{code}\"\n    return jsonify({'short_url': short_url})\n\n@app.route('/<code>')\ndef redirect_url(code):\n    original_url = url_store.get(code)\n    if original_url:\n        return redirect(original_url)\n    return jsonify({'error': 'Not found'}), 404" },
              explanation: "URL shorteners map short codes to original URLs."
            }
          ]
        }
      ],
      exercises: [
        {
          id: "ch78-ex1",
          title: "Shorten URL",
          difficulty: 1,
          description: "Create URL shortening function.",
