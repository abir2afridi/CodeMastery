              description: "Using @classmethod",
              code: { python: "class Employee:\n    company = \"TechCorp\"\n    \n    def __init__(self, name):\n        self.name = name\n    \n    @classmethod\n    def get_company(cls):\n        return cls.company\n\nprint(Employee.get_company())" },
              explanation: "@classmethod takes cls instead of self."
            }
          ]
        }
      ],
      exercises: [
