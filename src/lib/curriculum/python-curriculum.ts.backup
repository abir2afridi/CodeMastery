          whyItMatters: "Design patterns are reusable solutions to common design problems.",
          realWorldAnalogy: "Design patterns are like recipes - proven solutions to common problems.",
          content: `Singleton Pattern

class Singleton:
    _instance = None
    
    def __new__(cls):
        if cls._instance is None:
            cls._instance = super().__new__(cls)
        return cls._instance

Factory Pattern

class AnimalFactory:
    @staticmethod
    def create(animal_type):
        if animal_type == \"dog\":
            return Dog()
        elif animal_type == \"cat\":
            return Cat()`,
          codeExamples: [
            {
              id: "ch30-patterns",
              title: "Singleton Pattern",
              description: "Implementing Singleton",
              code: { python: "class Singleton:\n    _instance = None\n    \n    def __new__(cls):\n        if cls._instance is None:\n            cls._instance = super().__new__(cls)\n        return cls._instance\n\ns1 = Singleton()\ns2 = Singleton()\nprint(s1 is s2)  # True" },
              explanation: "Singleton ensures only one instance exists."
            }
          ]
        }
      ],
      exercises: [
