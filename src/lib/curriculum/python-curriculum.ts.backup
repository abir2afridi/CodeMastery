          starterCode: { python: "class Person:\n    def __init__(self, age):\n        self._age = age\n    \n    @property\n    def age(self):\n        return self._age\n    \n    @age.setter\n    def age(self, value):\n        # Validate age" },
          hints: ["Check age >= 0", "Check age <= 150"],
          solution: { python: "class Person:\n    def __init__(self, age):\n        self._age = age\n    \n    @property\n    def age(self):\n        return self._age\n    \n    @age.setter\n    def age(self, value):\n        if not 0 <= value <= 150:\n            raise ValueError(\"Invalid age\")\n        self._age = value" },
          solutionExplanation: "Properties enable validation without changing interface."
        }
