      title: "Quiz Application",
      subtitle: "Build interactive quiz",
      difficulty: "Intermediate",
      estimatedMinutes: 55,
      xpReward: 150,
      prerequisites: ["python-ch-78"],
      learningObjectives: [
        "Create quiz logic",
        "Handle user input",
        "Track scores",
        "Display results"
      ],
      sections: [
        {
          id: "ch79-quiz",
          title: "Quiz Application",
          whyItMatters: "Quiz applications demonstrate logic flow and user interaction handling.",
          realWorldAnalogy: "Quiz app is like a test - it asks questions and tracks answers.",
          content: "Quiz Structure\n\nquiz_data = [\n    {\n        'question': 'What is Python?',\n        'options': ['Language', 'Snake', 'Food', 'Tool'],\n        'correct': 0\n    }\n]\n\nQuiz Logic\n\ndef run_quiz(quiz):\n    score = 0\n    for q in quiz:\n        print(q['question'])\n        for i, opt in enumerate(q['options']):\n            print(f\"{i}. {opt}\")\n        answer = int(input('Your answer: '))\n        if answer == q['correct']:\n            score += 1\n    return score",
          codeExamples: [
            {
              id: "ch79-quiz",
              title: "Quiz Application",
              description: "Interactive quiz",
              code: { python: "class QuizApp:\n    def __init__(self, questions):\n        self.questions = questions\n        self.score = 0\n        self.current = 0\n    \n    def display_question(self):\n        q = self.questions[self.current]\n        print(f\"\\nQuestion {self.current + 1}: {q['question']}\")\n        for i, option in enumerate(q['options']):\n            print(f\"  {i + 1}. {option}\")\n    \n    def check_answer(self, answer):\n        q = self.questions[self.current]\n        if answer - 1 == q['correct']:\n            self.score += 1\n            print(\"Correct!\")\n        else:\n            print(f\"Wrong! Answer: {q['options'][q['correct']]}\")\n    \n    def run(self):\n        while self.current < len(self.questions):\n            self.display_question()\n            answer = int(input(\"Your answer: \"))\n            self.check_answer(answer)\n            self.current += 1\n        print(f\"\\nFinal Score: {self.score}/{len(self.questions)}\")" },
              explanation: "Quiz apps manage question flow and scoring."
            }
          ]
        }
      ],
      exercises: [
        {
          id: "ch79-ex1",
          title: "Simple Quiz",
          difficulty: 1,
          description: "Create simple quiz function.",
          requirements: ["Ask question", "Check answer"],
