          realWorldAnalogy: "Generators are like on-demand production - items are created only when needed.",
          content: `Generator Syntax

def generator():
    yield 1
    yield 2
    yield 3

Generator Expressions

squares = (x**2 for x in range(1000000))`,
          codeExamples: [
            {
              id: "ch15-generators",
              title: "Generator Functions",
              description: "Using generators",
              code: { python: "def countdown(n):\n    while n > 0:\n        yield n\n        n -= 1\n\nfor num in countdown(3):\n    print(num)  # 3, 2, 1" },
              explanation: "Generators use yield instead of return."
            }
          ]
        }
      ],
      exercises: [
        {
          id: "ch15-ex1",
          title: "Fibonacci Generator",
          difficulty: 1,
          description: "Create Fibonacci generator.",
          requirements: ["Use yield", "Generate sequence"],
          starterCode: { python: "def fibonacci(n):\n    a, b = 0, 1\n    # Your code here" },
          hints: ["Use while loop", "Yield a, then update"],
          solution: { python: "def fibonacci(n):\n    a, b = 0, 1\n    for _ in range(n):\n        yield a\n        a, b = b, a + b" },
          solutionExplanation: "Generators yield one value at a time."
        }
      ],
