          starterCode: { python: "class Shape:\n    def area(self):\n        pass\n\n# Create Circle and Rectangle" },
          hints: ["Override area() in each", "Return calculated area"],
          solution: { python: "class Shape:\n    def area(self):\n        pass\n\nclass Circle(Shape):\n    def __init__(self, radius):\n        self.radius = radius\n    def area(self):\n        return 3.14 * self.radius ** 2\n\nclass Rectangle(Shape):\n    def __init__(self, width, height):\n        self.width = width\n        self.height = height\n    def area(self):\n        return self.width * self.height" },
          solutionExplanation: "Polymorphism allows same method name with different implementations."
        }
      ],
