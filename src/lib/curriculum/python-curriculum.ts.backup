          realWorldAnalogy: "Mocking is like using stand-ins - you replace real components with test doubles.",
          content: `Basic Mock

from unittest.mock import Mock

mock = Mock()
mock.method.return_value = 42
assert mock.method() == 42

Patching

from unittest.mock import patch

with patch('module.function') as mock_func:
    mock_func.return_value = 'mocked'
    # Test code here`,
          codeExamples: [
            {
              id: "ch53-mocking",
              title: "Mocking",
              description: "Isolate dependencies",
              code: { python: "from unittest.mock import Mock, patch\n\ndef fetch_data():\n    # Simulate external API call\n    return \"real data\"\n\ndef process_data():\n    data = fetch_data()\n    return data.upper()\n\n# Test with mock\nwith patch('__main__.fetch_data', return_value=\"test data\"):\n    assert process_data() == \"TEST DATA\"" },
              explanation: "Mocking replaces dependencies for testing."
            }
          ]
        }
      ],
      exercises: [
        {
          id: "ch53-ex1",
          title: "Mock Function",
          difficulty: 1,
          description: "Create a mock for testing.",
          requirements: ["Use Mock", "Set return value"],
          starterCode: { python: "from unittest.mock import Mock\n\ndef get_user_data(user_id):\n    # External API call\n    pass\n\ndef display_user(user_id):\n    data = get_user_data(user_id)\n    return f\"User: {data}\"\n\n# Test with mock" },
          hints: ["patch get_user_data", "Set return_value"],
          solution: { python: "from unittest.mock import patch\n\ndef get_user_data(user_id):\n    pass\n\ndef display_user(user_id):\n    data = get_user_data(user_id)\n    return f\"User: {data}\"\n\nwith patch('__main__.get_user_data', return_value=\"Alice\"):\n    assert display_user(1) == \"User: Alice\"" },
          solutionExplanation: "Mocking isolates code from dependencies."
        }
      ],
      quiz: {
