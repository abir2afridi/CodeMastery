          starterCode: { python: "class ShapeFactory:\n    @staticmethod\n    def create(shape_type):\n        # Return shape based on type" },
          hints: ["Use if/elif", "Return instances"],
          solution: { python: "class ShapeFactory:\n    @staticmethod\n    def create(shape_type):\n        if shape_type == \"circle\":\n            return Circle()\n        elif shape_type == \"square\":\n            return Square()\n        else:\n            raise ValueError(\"Unknown shape\")" },
          solutionExplanation: "Factory patterns encapsulate object creation."
        }
      ],
