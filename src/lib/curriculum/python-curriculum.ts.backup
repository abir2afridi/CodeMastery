              code: { python: "class Animal:\n    def __init__(self, name):\n        self.name = name\n\nclass Dog(Animal):\n    def __init__(self, name, breed):\n        super().__init__(name)\n        self.breed = breed\n\ndog = Dog(\"Buddy\", \"Lab\")\nprint(dog.name, dog.breed)" },
              explanation: "Child classes inherit from parent classes using parentheses."
            }
          ]
        }
      ],
