          content: `API Client Class

import requests

class APIClient:
    def __init__(self, base_url, api_key):
        self.base_url = base_url
        self.headers = {'Authorization': 'Bearer {}'.format(api_key)}
    
    def get(self, endpoint):
        url = f\"{self.base_url}{endpoint}\"\n        response = requests.get(url, headers=self.headers)
        return response.json()

Error Handling

try:
    data = client.get('/users')
except requests.exceptions.RequestException as e:
    print(f\"Error: {e}\")`,
          codeExamples: [
            {
              id: "ch74-api",
              title: "API Client",
              description: "API integration",
              code: { python: "import requests\n\nclass GitHubClient:\n    def __init__(self, token):\n        self.base_url = 'https://api.github.com'\n        self.headers = {'Authorization': 'token {}'.format(token)}\n    \n    def get_user(self, username):\n        url = f\"{self.base_url}/users/{username}\"\n        response = requests.get(url, headers=self.headers)\n        if response.status_code == 200:\n            return response.json()\n        return None\n    \n    def get_repos(self, username):\n        url = f\"{self.base_url}/users/{username}/repos\"\n        response = requests.get(url, headers=self.headers)\n        return response.json()\n\n# Usage\nclient = GitHubClient('your_token')\nuser = client.get_user('octocat')\nprint(user)" },
              explanation: "API clients provide structured interfaces to external services."
            }
          ]
        }
